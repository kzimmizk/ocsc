---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const financialAssistance = await getEntry('pages', 'financial-assistance');
if (!financialAssistance) throw new Error('Missing pages/financial-assistance.md');
const { Content } = await render(financialAssistance);
---

<BaseLayout
  title={financialAssistance.data.title}
  description={financialAssistance.data.description}
>
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">Registration</p>
      <h1>{financialAssistance.data.title}</h1>
      <Content />
    </div>
  </section>
</BaseLayout>

<style>
  .prose {
    max-width: 76ch;
  }
  .prose :global(h2) {
    margin-top: 2.5rem;
  }
  .prose :global(.page-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin: 1.5rem 0 2.25rem;
  }
  .prose :global(figure) {
    margin: 1.5rem 0 2rem;
  }
  .prose :global(figure img) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  .prose :global(figcaption) {
    margin-top: 0.5rem;
    color: var(--color-muted);
    font-size: 0.9rem;
  }
</style>
