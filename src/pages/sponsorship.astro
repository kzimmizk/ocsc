---
import BaseLayout from '../layouts/BaseLayout.astro';
import SponsorGrid from '../components/SponsorGrid.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'sponsorship');
if (!page) throw new Error('Missing pages/sponsorship.md');
const { Content } = await render(page);

const settings = await getEntry('settings', 'site');
const donateUrl = settings?.data.donateUrl;
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="sponsorship-hero">
    <div class="container sponsorship-hero__content">
      <div class="sponsorship-hero__title">
        <p class="eyebrow">Support Us</p>
        <h1>{page.data.title}</h1>
        <p>{page.data.summary}</p>
      </div>
    </div>
  </section>

  <section class="section sponsorship-details">
    <div class="container">
      <div class="prose">
        <Content />
      </div>
      {
        donateUrl && (
          <aside class="donate-cta" aria-label="Donation call to action">
            <div>
              <p class="eyebrow">Make a difference</p>
              <h2>Help local players thrive</h2>
              <p>
                Sponsor a 2027 practice jersey or make a tax-deductible gift to
                support youth soccer in Ouray County.
              </p>
            </div>
            <a class="btn btn--primary" href={donateUrl} rel="noopener">
              Donate Now
            </a>
          </aside>
        )
      }
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Our Sponsors</h2>
      <p class="section__intro">
        We're grateful to the local businesses and families who support youth
        soccer in Ouray County.
      </p>
      <SponsorGrid />
    </div>
  </section>
</BaseLayout>

<style>
  .sponsorship-hero {
    position: relative;
    min-height: clamp(24rem, 45vw, 32rem);
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
      linear-gradient(135deg, transparent 0 58%, rgba(32, 168, 224, 0.13) 58%),
      linear-gradient(110deg, var(--color-primary-dark), var(--color-primary));
  }

  .sponsorship-hero::after {
    content: '';
    position: absolute;
    top: -20%;
    right: -7%;
    width: min(38vw, 32rem);
    aspect-ratio: 1;
    border: clamp(2rem, 5vw, 4rem) solid rgba(32, 168, 224, 0.55);
    border-radius: 50%;
  }

  .sponsorship-hero__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(2rem, 7vw, 5rem);
  }

  .sponsorship-hero__title {
    width: min(100%, 38rem);
    padding: clamp(1.5rem, 4vw, 3rem);
    color: var(--color-on-primary);
    background: rgba(10, 42, 82, 0.92);
    border-left: 0.5rem solid var(--color-accent);
    box-shadow: 0 1.25rem 3rem rgba(6, 27, 56, 0.32);
  }

  .sponsorship-hero__title h1 {
    color: inherit;
  }

  .sponsorship-hero__title p:last-child {
    max-width: 40ch;
    margin-bottom: 0;
    font-size: clamp(1rem, 2vw, 1.2rem);
  }

  .sponsorship-hero .eyebrow {
    color: #8edcff;
  }

  .sponsorship-details {
    background: linear-gradient(90deg, #dff3fc 0 34%, var(--color-bg) 34%);
  }

  .prose {
    max-width: 62rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    background: var(--color-bg);
    box-shadow: var(--shadow);
  }

  .prose :global(h2) {
    margin-top: 2.5rem;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global([id='2027-practice-jersey-sponsorships']) {
    margin-top: 3rem;
    padding: 1.25rem 1.5rem;
    color: var(--color-on-primary);
    background: var(--color-primary);
    border-left: 0.5rem solid var(--color-accent);
  }

  .prose :global([id='2027-practice-jersey-sponsorships'] + ul) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin: 1.25rem 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .prose :global([id='2027-practice-jersey-sponsorships'] + ul li) {
    padding: 1.25rem;
    background: #dff3fc;
    border-top: 0.35rem solid var(--color-accent);
    border-radius: var(--radius-sm);
  }

  .prose :global([id='2027-practice-jersey-sponsorships'] + ul strong) {
    display: block;
    color: var(--color-primary);
    font-size: 1.12rem;
  }

  .prose :global(#what-your-support-makes-possible + ul) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem 2rem;
    padding-left: 0;
    list-style: none;
  }

  .prose :global(#what-your-support-makes-possible + ul li) {
    position: relative;
    padding-left: 1.75rem;
  }

  .prose :global(#what-your-support-makes-possible + ul li::before) {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--color-accent-dark);
    font-weight: 800;
  }

  .prose :global(#inclusive-community-values) {
    margin: 2.75rem -1rem 0;
    padding: 1.5rem 1.5rem 0;
    border-top: 1px solid var(--color-border);
  }

  .prose :global(#inclusive-community-values ~ p) {
    margin-inline: 0.5rem;
  }

  .donate-cta {
    max-width: 62rem;
    margin: 1.5rem auto 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    color: var(--color-on-primary);
    background: var(--color-primary);
    box-shadow: var(--shadow);
  }

  .donate-cta h2 {
    color: inherit;
  }

  .donate-cta p:last-child {
    max-width: 52ch;
    margin-bottom: 0;
  }

  .donate-cta .eyebrow {
    color: #8edcff;
  }

  .donate-cta .btn {
    flex: 0 0 auto;
  }

  @media (max-width: 700px) {
    .sponsorship-hero {
      min-height: 27rem;
    }

    .sponsorship-hero::after {
      top: -3rem;
      right: -8rem;
      width: 20rem;
      border-width: 2.5rem;
    }

    .sponsorship-hero__title {
      width: 100%;
    }

    .sponsorship-details {
      background: #dff3fc;
    }

    .prose :global([id='2027-practice-jersey-sponsorships'] + ul),
    .prose :global(#what-your-support-makes-possible + ul) {
      grid-template-columns: 1fr;
    }

    .donate-cta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
